# ─────────────────────────────────────────
# OmniConnect Fitness — Variáveis de Ambiente
# ─────────────────────────────────────────

# ── App ──────────────────────────────────
APP_NAME="OmniConnect Fitness API"
APP_VERSION="1.0.0"
APP_ENV="development"
DEBUG=True
SECRET_KEY="troque-por-uma-chave-segura-de-64-chars"
ADMIN_NAME="Administrador OmniConnect"
ADMIN_EMAIL="admin@omniconnect.fit"
ADMIN_PASSWORD="AdminForte123!"

# ── Banco de Dados (Configuração do Docker-Compose)
# Note que estamos usando 'db' como host, que é o nome do container no docker-compose.yml
# Usando asyncpg para conexões assíncronas
DATABASE_URL="postgresql+asyncpg://omni_user:omni_pass@db:5432/omniconnect_db"
DATABASE_ECHO=True

# ── Integência Artificial / Agentes LangChain ─────────────────────────────
OPENAI_API_KEY="sk-SuaChaveDaOpenAiAqui..."
GROQ_API_KEY="sua-chave-groq-aqui"
GROQ_MODEL="llama-3.3-70b-versatile"

# ── Integrações (WhatsApp Cloud API e Firebase) ────────────────────
WHATSAPP_TOKEN="seu-token-da-meta-aqui"
WHATSAPP_PHONE_NUMBER_ID="seu-phone-number-id"
WHATSAPP_VERIFY_TOKEN="token-que-voce-cria-para-verificar-webhook"
FIREBASE_CREDENTIALS_PATH="./firebase-credentials.json"

# ── Recuperação de Senha ─────────────────────────────────
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# ── Resend (Email) ──────────────────────────────────────
RESEND_API_KEY="re_sua_chave_aqui"
RESEND_FROM_EMAIL="noreply@getfitloop.com"
RESEND_FROM_NAME="OmniConnect Fitness"

# ── Frontend URLs ───────────────────────────────────────
FRONTEND_URL="http://localhost:3000"
FRONTEND_RESET_PASSWORD_ROUTE="/reset-password"

# ── Rate Limit ──────────────────────────────────────────
PASSWORD_RESET_RATE_LIMIT="5/hour"
